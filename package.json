{
  "name": "waica",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "pnpm --filter @waica/example-platformer dev",
    "editor": "pnpm --filter @waica/editor dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:dist": "pnpm build && node scripts/test-dist.mjs",
    "typecheck": "pnpm -r typecheck",
    "release": "pnpm test:dist && pnpm -r --filter './packages/*' publish --access public"
  },
  "devDependencies": {
    "happy-dom": "^20.11.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
