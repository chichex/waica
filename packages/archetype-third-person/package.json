{
  "name": "@waica/archetype-third-person",
  "version": "0.30.1",
  "description": "Waica third-person archetype — an orbit camera, camera-relative controls and 3D melee combat in a dungeon courtyard",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/chichex/waica",
    "directory": "packages/archetype-third-person"
  },
  "files": [
    "dist",
    "assets"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./manifest": {
        "types": "./dist/manifest.d.ts",
        "default": "./dist/manifest.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@waica/behaviors": "workspace:^",
    "@waica/engine": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
